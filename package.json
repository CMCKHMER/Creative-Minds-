{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "build": "node scripts/build_planner_title.mjs && vite build",
    "build:planner-title": "node scripts/build_planner_title.mjs",
    "dev": "vite",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rules:min": "node scripts/build_min_rules.mjs",
    "seal": "node scripts/seal_tests.mjs && node scripts/test_counts.mjs",
    "seal:check": "node scripts/seal_tests.mjs --check && node scripts/test_counts.mjs --check",
    "verify:biweek": "node scripts/verify_biweek_results.mjs",
    "verify:kidhw": "node scripts/verify_kid_homework.mjs",
    "verify:title": "node scripts/verify_title_particles.mjs",
    "verify:planner-title": "node scripts/verify_planner_title.mjs",
    "verify:planner-page-title": "node scripts/verify_planner_page_title.mjs",
    "verify:pages": "node scripts/verify_pages.mjs",
    "verify:wordcreator": "node scripts/verify_word_creator.mjs",
    "verify:registration": "node scripts/verify_registration.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.109.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "clsx": "2.1.1",
    "firebase": "^13.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.43.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "minimatch": "^11.0.1"
  }
}
