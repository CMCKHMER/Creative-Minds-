rules_version = '2';

// Creative Minds Cambodia — production Firestore security rules.
//
// HOW TO DEPLOY (one-time, ~2 minutes — no CLI needed):
//   1. Open https://console.firebase.google.com → project "creative-minds-cambodia"
//   2. Build → Firestore Database → Rules tab  (database: "(default)")
//   3. Paste this entire file over the editor contents → click "Publish"
//
// ⚠️ REGRESSION FIX (Oct 2026): an earlier revision wrote
// `match /drill_attempts` and `match /teacher_chat` as bare collection
// paths. Firestore rules match DOCUMENT paths, not collection paths, so
// those blocks matched nothing — every read/write fell through to the
// default-deny wildcard, breaking the live ticker, chat wall and drill
// submissions with "Missing or insufficient permissions". A match path
// for a top-level collection MUST carry a document wildcard segment:
//   match /collection/{docId}        (that collection's documents)
//   match /collection/{document=**}  (documents + all subcollections)
//
// WHAT THESE RULES DO (and why):
//   - drill_attempts/{attemptId}: public read (the homepage ticker, game
//     leaderboard and dashboards list it anonymously via the REST API);
//     creates for SIGNED-IN users submitting their OWN uid (a signed-in
//     student cannot forge scores for classmates) PLUS a validated guest
//     branch — empty studentUid, size/range-checked name & fields, no
//     class attribution — so visitors who play the games appear on the
//     ticker and leaderboards too (Nov 2026). Scores are immutable
//     (no update/delete by clients).
//   - teacher_chat/{msgId}: RETIRED (Nov 2026) — replaced by the blog-style
//     `announcements` board. Kept publicly readable so old messages stay
//     reachable, but every write is denied: the chat UI is gone.
//   - announcements/{postId}: public read (blog-style board on the landing
//     page); create/update/delete ONLY for approved admins — the site owner
//     (isCmcAdmin) plus any UID listed in site_config/admins.uids.
//   - site_config/{configId}: public read, owner-only write. The admins doc
//     here is the approval allowlist the owner manages in-app, so approving
//     a new announcement admin never requires redeploying these rules.
//   - students/{uid}: each student can read/write only their own profile.
//   - classes/{classId} + enrollments: public read (code lookup /
//     dashboards), signed-in writes, students enroll themselves. DELETE is
//     owner-only: the class doc's teacherUid must match the caller, and
//     enrollment cleanup is allowed for the teacherUid stamped on each
//     enrollment doc at join time (or by the enrolled student themself —
//     "leave class"). No rules get() calls, so bulk cleanup in one pass
//     never hits the document-access limit.
//   - assessment_classes/{classId} (+ students subcollection): the Daily
//     Student Assessment Records workspace. TEACHERS ONLY — the signed-in
//     account's email must contain "edu" (the same heuristic RoleGate uses
//     site-wide). Replaces the retired Google Apps Script/Sheets backend,
//     whose "Anyone" web-app deployment let any visitor read or wipe
//     all records.
//   - Everything else: denied.
//
// EMAIL VERIFICATION GATE (Oct 2026): every account must verify its email
// address (Firebase sends the link at sign-up; sign-in is blocked until it
// is clicked). isVerifiedUser() enforces this server-side: unverified
// sessions can authenticate NOTHING except creating their own students/
// {uid} profile doc at sign-up. This is defense in depth — the client
// already refuses to hold or mint sessions for unverified accounts.
// ⚠️ PUBLISH REQUIRED: these rules take effect only after pasting this
// file into Firebase Console → Firestore → Rules and clicking Publish.
//
// VERIFIED against the live write shape (Oct 2026): every worksheet POST
// (biweek-planner, toefl-ibt, rfc2, rfc3, syntax-clash, writequest, the
// React submitScore module and CMC.submitDrill) sends integer scorePct
// 0-100, integer correctCount/totalCount >= 0, and studentUid matching
// the Bearer token's own uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // SITE-OWNER ADMIN GRANT (Oct 2026): the owner's account is admin of
    // the whole site, keyed by Firebase UID (immutable across email
    // changes; the uid is already public via the classes collection as
    // teacherUid). Email verification is still required. OR'd into
    // isCmcTeacher() so EVERY teacher gate opens for this account, and
    // isVerifiedTeacher() waives the teachers/{uid} allowlist doc for it.
    // The same UID is hardcoded client-side (src/lib/firebaseAuth.ts
    // ADMIN_UIDS) — keep the two in sync.
    function isCmcAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == '5iLvnjzmV8QY7WFZhyTq6PIgcI63';
    }

    // A signed-in account whose email contains "edu" — or the site-owner
    // admin account — that finished email verification. This is the same
    // heuristic the CMC app (RoleGate / firebaseAuth.detectRoleFromEmail)
    // uses to decide who is a teacher, hardened with the verification gate
    // and extended with the admin grant. RE2 has no look-around, so keep
    // this in sync with the app if the heuristic ever changes.
    function isCmcTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (request.auth.token.email.matches('.*[eE][dD][uU].*')
            || isCmcAdmin());
    }

    // A signed-in account that proved its email address by clicking the
    // verification link. Required for every student-reachable write.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    match /drill_attempts/{attemptId} {
      allow read: if true; // public scoreboard (ticker / leaderboard / dashboard)

      // GUEST ATTEMPTS (Nov 2026): games used to record nothing for visitors
      // who never signed up, so the homepage ticker never moved. Guests may
      // now create attempts too — with an EMPTY studentUid (they have no
      // account to claim) and every user-typed field size/range checked.
      // Trade-off, accepted on purpose: a guest's displayed name and score
      // are self-reported, so forged guest rows are possible. They can only
      // pollute the motivational ticker/leaderboard — no class attribution
      // (classId must be null), no account impact, append-only, and the
      // signed-in path below still pins rows to the caller's own verified uid.
      allow create: if (
          isVerifiedUser()
          && request.resource.data.studentUid == request.auth.uid
          && request.resource.data.studentUid is string
          && request.resource.data.studentName is string
          && request.resource.data.drillSlug is string
          && request.resource.data.drillTitle is string
          && request.resource.data.drillSource is string
          && request.resource.data.scorePct is int
          && request.resource.data.scorePct >= 0
          && request.resource.data.scorePct <= 100
          && request.resource.data.correctCount is int
          && request.resource.data.correctCount >= 0
          && request.resource.data.totalCount is int
          && request.resource.data.totalCount >= 0
        ) || (
          request.auth == null
          && request.resource.data.studentUid == ''
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() >= 1
          && request.resource.data.studentName.size() <= 40
          && request.resource.data.drillSlug is string
          && request.resource.data.drillSlug.size() >= 1
          && request.resource.data.drillSlug.size() <= 80
          && request.resource.data.drillTitle is string
          && request.resource.data.drillTitle.size() >= 1
          && request.resource.data.drillTitle.size() <= 120
          && request.resource.data.drillSource is string
          && request.resource.data.drillSource.size() >= 1
          && request.resource.data.drillSource.size() <= 40
          && request.resource.data.scorePct is int
          && request.resource.data.scorePct >= 0
          && request.resource.data.scorePct <= 100
          && request.resource.data.correctCount is int
          && request.resource.data.correctCount >= 0
          && request.resource.data.correctCount <= 10000
          && request.resource.data.totalCount is int
          && request.resource.data.totalCount >= 0
          && request.resource.data.totalCount <= 10000
          && (!('classId' in request.resource.data) || request.resource.data.classId == null)
        );

      // Score history is append-only — nobody rewrites results.
      allow update, delete: if false;
    }

    match /teacher_chat/{msgId} {
      allow read: if true; // retired chat wall — old messages stay readable
      // Retired Nov 2026: replaced by /announcements. No client writes it.
      allow create, update, delete: if false;
    }

    // ANNOUNCEMENT BOARD (Nov 2026): blog-style replacement for teacher_chat.
    // Everyone can read; only APPROVED ADMINS can publish, edit, pin or
    // delete. Approval = the site-owner UID (isCmcAdmin) or an entry in the
    // site_config/admins allowlist doc, which the owner manages in-app.
    function isCmcApprovedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isCmcAdmin()
            || (exists(/databases/$(database)/documents/site_config/admins)
                && request.auth.uid in
                    get(/databases/$(database)/documents/site_config/admins).data.get('uids', [])));
    }

    match /announcements/{postId} {
      allow read: if true; // public blog-style board

      allow create: if isCmcApprovedAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000 // downscaled data URL; keeps docs under 1 MiB
        && request.resource.data.pinned is bool
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.authorEmail is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Collegial editing, like assessment_classes: any approved admin can
      // edit/pin/delete any post. Writes are stamped with authorUid at
      // create time, so authorship stays attributable.
      allow update, delete: if isCmcApprovedAdmin();
    }

    match /site_config/{configId} {
      allow read: if true; // approved admins read the list to check their own status
      allow write: if isCmcAdmin(); // only the owner grants/revokes admin access
    }

    match /students/{uid} {
      // CREATE with just sign-in: the signup flow writes the profile doc
      // while the brand-new (still unverified) auth context exists. Every
      // other access — read included — requires a verified email.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isVerifiedUser() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if true; // class-code lookup + dashboards
      allow create, update: if isVerifiedUser();
      // Owner-only delete: `resource` is the class doc being removed, and
      // every class doc carries teacherUid (createClass stamps it), so this
      // costs no extra reads. Delete also implicitly drops the class code
      // from join lookups (getClassByCode queries this collection).
      allow delete: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid;

      match /enrollments/{studentUid} {
        allow read: if true;
        allow create, update: if isVerifiedUser() && request.auth.uid == studentUid;
        // Delete: the enrolled student themself (leave class), or the class
        // owner (teacherUid was stamped on the enrollment doc at join time).
        // Docs created before that stamping began have no teacherUid —
        // resource.data.teacherUid is then null and the comparison denies,
        // which is safe: they remain harmless orphans under a deleted class.
        allow delete: if isVerifiedUser()
          && (request.auth.uid == studentUid
              || resource.data.teacherUid == request.auth.uid);
      }
    }

    // Daily Student Assessment Records — teachers-only workspace.
    // Read: any teacher (staff-room visibility of rosters/averages).
    // Write: any teacher (collegial editing — every write is stamped with
    // updatedBy + server updatedAt in the client data layer, so edits are
    // attributable). Classes are archived, never deleted, from the client.
    match /assessment_classes/{classId} {
      allow read: if isCmcTeacher();
      allow create: if isCmcTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid is string;
      allow update: if isCmcTeacher();
      allow delete: if false;

      match /students/{studentId} {
        allow read: if isCmcTeacher();
        allow create, update: if isCmcTeacher();
        allow delete: if isCmcTeacher();
      }
    }

    // ── Private bi-weekly test system (Option A: teacher-side grading) ──
    //
    // Flow: teacher creates test_assignments/{id} for a class → students open
    // the private (answer-free) test page, sign in, and POST raw answers to
    // test_submissions/{assignmentId}__{studentUid} → the teacher dashboard
    // grades locally against test_keys/{testId} and caches scores in
    // test_scores/{submissionId}. Students can NEVER read the key, any score,
    // or anyone else's submission.
    //
    // teachers/{uid}: append-only allowlist that hardens the "email contains
    // edu" heuristic for the sensitive collections (answer keys!). Any edu
    // account may register itself ONCE (create), after which the doc is
    // immutable. Sensitive collections require BOTH the edu heuristic AND an
    // allowlist entry. To tighten further, replace isCmcTeacher() inside
    // isVerifiedTeacher() with a hardcoded email check.

    match /teachers/{uid} {
      allow read: if request.auth != null; // role checks only; non-sensitive
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isCmcTeacher();
      allow update, delete: if false; // allowlist is append-only
    }

    function isVerifiedTeacher() {
      return request.auth.uid is string
        && (isCmcAdmin()
            || (isCmcTeacher()
                && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))));
    }

    // Test shell metadata (title, groups, question count). NO answers here.
    match /biweekly_tests/{testId} {
      allow read: if true;
      allow create, update: if isVerifiedTeacher();
      allow delete: if false;
    }

    // THE answer key. The single most protected collection on the site.
    match /test_keys/{testId} {
      allow read, write: if isVerifiedTeacher();
    }

    // One assignment = test + class + window.
    match /test_assignments/{assignmentId} {
      allow read: if isVerifiedTeacher()
        || (isVerifiedUser()
            && resource.data.classId is string
            && exists(/databases/$(database)/documents/classes/$(resource.data.classId)/enrollments/$(request.auth.uid)));
      allow create, update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    // Raw student answers. Doc ID is "{assignmentId}__{studentUid}" so the
    // create-once rule IS the one-attempt rule: a second create with the same
    // ID fails at the database level, not just in the UI. Students may GET
    // their own doc (resume UX) but can never list or read anyone else's.
    match /test_submissions/{docId} {
      allow get: if isVerifiedTeacher()
        || (isVerifiedUser()
            && resource.data.studentUid == request.auth.uid);
      allow list: if isVerifiedTeacher();

      allow create: if isVerifiedUser()
        && request.auth.uid is string
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.testId is string
        && request.resource.data.classId is string
        && request.resource.data.studentName is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.answers is map
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 300
        && request.resource.data.integrity is map
        && docId == (request.resource.data.assignmentId + '__' + request.auth.uid)
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.opensAt <= request.time
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.closesAt >= request.time;

      // Append-only: nobody (not even the teacher) rewrites a submission.
      allow update, delete: if false;
    }

    // Computed scores + per-skill breakdown + most-missed data. Teachers only.
    match /test_scores/{docId} {
      allow read, write: if isVerifiedTeacher();
    }

    // SERVER-AGGREGATED TICKER STATS (Blaze plan, Oct 2026): the scheduled
    // rollupTicker Cloud Function (functions/index.js) rewrites
    // ticker_stats/latest every 5 minutes with the homepage ticker's stats.
    // Public read lets every visitor's ticker fetch ONE pre-aggregated
    // document per poll instead of running the week-window + two count()
    // queries itself — per-visitor cost drops to a single read no matter how
    // busy the week is. Writes are DENIED to all clients: the doc is
    // maintained exclusively by the Cloud Function, whose Admin SDK access
    // bypasses security rules entirely.
    match /ticker_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ONLINE CHESS ROOMS (Nov 2026): the realtime table for Arena Chess 3D
    // online duels. One document per room (5-letter code as the doc id):
    // the host creates it, a guest claims the open seat, then both players
    // append SAN moves. BOTH clients replay the move list through chess.js
    // and validate every transition locally — these rules enforce identity
    // and document shape, not move legality (a hostile writer could inject
    // nonsense into their OWN room; it can never touch anyone else's, and
    // the replaying client simply shows the position the moves produce).
    // All writes require a verified account; reads too, so room codes are
    // only reachable by real CMC members.
    match /chess_rooms/{roomId} {
      allow read: if isVerifiedUser();

      // Create: only your own room, brand-new and empty, code == doc id.
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.hostColor in ['w', 'b']
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.result == null
        && request.resource.data.drawOffer == null
        && request.resource.data.gameNo == 1;

      // Join: a verified player claims the open guest seat. Afterwards,
      // only the two seated players may touch the room (move appends,
      // resign, draw offers, rematch gameNo bump). Firestore cannot verify
      // chess legality — that is the client replay's job — but identity is
      // hard-enforced: nobody else can read, join or disturb the table.
      allow update: if isVerifiedUser()
        && ((resource.data.guestUid == null
             && request.resource.data.guestUid == request.auth.uid)
            || request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid);

      // Cleanup: the host can take a dead table down.
      allow delete: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;
    }

    // ── STUDIO SHARED DOCS & WORKSHEETS (Nov 2026) ──
    //
    // The Studio page (studio/) can publish a Docs or Excel document to a
    // live share link (?doc=<id>). Two modes:
    //   view    — everyone with the link sees a read-only copy
    //   collect — students open the link, fill the teacher-marked input
    //             cells (sheets) or their own copy of the document (docs),
    //             and press Submit; answers land in studio_submissions.
    //
    // studio_docs/{docId}: document id is an unguessable Firestore auto-ID,
    // so share links work exactly by knowing the link. Content is classroom
    // material, not secrets → public read, like biweekly_tests.
    // Create/update: teachers only (the same edu-email heuristic the app
    // uses site-wide, hardened with email verification). Update is
    // owner-only (republishing your own doc; kind can never change so a
    // doc can't be morphed into a different shape after the fact).
    // Delete: owner-only, so a teacher can remove a mis-shared link.
    // Size: the doc field is capped (600 KB) and sheets list capped (12);
    // Firestore's own 1 MiB per-document limit is the hard backstop.
    // linkedTest (optional, top-level): a student-safe copy of a bi-week
    // test — questions only. The key whitelist below makes it IMPOSSIBLE to
    // publish an answer field inside linkedTest, even from a tampered
    // client: keys must be exactly {slug,title,kicker,instructions,
    // transcript,minutes,groups,questions,audios,total} and each question
    // exactly {g,i,p,c,m}. Grading uses the live test page at Results time
    // (teacher-only), so the key never enters the database at all.
    function linkedTestQuestionOk(q) {
      return q is map
        && q.keys().hasOnly(['g', 'i', 'p', 'c', 'm'])
        && q.g is string && q.g.size() >= 1 && q.g.size() <= 100
        && q.i is number && q.i >= 0 && q.i <= 500
        && q.p is string && q.p.size() >= 1 && q.p.size() <= 2000
        && q.c is list && q.c.size() >= 2 && q.c.size() <= 12
        && q.c.all(ch, ch is string && ch.size() >= 0 && ch.size() <= 2000)
        && (q.m is bool || q.m == null);
    }
    function linkedTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'kicker', 'instructions', 'transcript', 'minutes', 'groups', 'questions', 'audios', 'total'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 200
        && t.kicker is string && t.kicker.size() <= 200
        && t.instructions is string && t.instructions.size() <= 4000
        && t.transcript is string && t.transcript.size() <= 8000
        && t.minutes is number && t.minutes >= 0 && t.minutes <= 300
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.groups is list && t.groups.size() >= 1 && t.groups.size() <= 50
        && t.groups.all(g, g is map && g.keys().hasOnly(['id', 'title', 'dirs'])
          && g.id is string && g.id.size() >= 1 && g.id.size() <= 100
          && g.title is string && g.title.size() <= 300
          && g.dirs is string && g.dirs.size() <= 600)
        && t.questions is list && t.questions.size() >= 1 && t.questions.size() <= 500
        && t.questions.all(linkedTestQuestionOk)
        && t.audios is list && t.audios.size() <= 20
        && t.audios.all(a, a is map && a.keys().hasOnly(['label', 'src'])
          && a.label is string && a.label.size() <= 300
          && a.src is string && a.src.size() <= 300);
    }
    function studioDocFieldsOk(d) {
      return d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 200
        && d.kind in ['doc', 'sheet']
        && d.mode in ['view', 'collect']
        && d.ownerUid == request.auth.uid
        && d.ownerName is string
        && d.ownerName.size() >= 1
        && d.ownerName.size() <= 60
        && d.createdAt is string
        && d.createdAt.size() <= 40
        && d.updatedAt is string
        && d.updatedAt.size() <= 40
        && d.revision is number
        && d.revision >= 1
        && d.revision <= 10000
        && d.data is map
        && (!(d.keys().hasAny(['linkedTest'])) || linkedTestOk(d.linkedTest))
        && ((d.kind == 'doc'
             && d.data.doc is string
             && d.data.doc.size() <= 600000
             && d.data.docHeader is string
             && d.data.docHeader.size() <= 60000
             && d.data.docFooter is string
             && d.data.docFooter.size() <= 60000)
           || (d.kind == 'sheet'
             && d.data.sheets is list
             && d.data.sheets.size() >= 1
             && d.data.sheets.size() <= 12));
    }

    match /studio_docs/{docId} {
      allow read: if true; // share links; content is classroom material

      allow create: if isCmcTeacher() && studioDocFieldsOk(request.resource.data);

      // Republish after edits: owner-only, shape-preserving (kind stays).
      allow update: if isCmcTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == resource.data.kind
        && studioDocFieldsOk(request.resource.data);

      allow delete: if isCmcTeacher() && resource.data.ownerUid == request.auth.uid;

      // "My published docs" dashboard in the Share dialog. The list itself
      // is teacher-only; the where('ownerUid') equality is enforced by the
      // client and the collection is publicly readable anyway.
      allow list: if isCmcTeacher();
    }

    // studio_submissions/{subId}: student answers for a collect worksheet.
    // Append-only (no update/delete for anyone — like test_submissions).
    //   Signed-in students: doc id pins ONE attempt per student per
    //   worksheet — "{docId}__{studentUid}", create-once, second submit
    //   fails at the database level (the client surfaces it as 409).
    //   Guests: "{docId}__guest_<random>" with a validated self-reported
    //   name — same accepted trade-off as the guest drill_attempts branch:
    //   a forged guest row only adds a fake row to one worksheet's results;
    //   it can never touch another submission or the published document.
    // Reading results: teachers only. Students may GET their own doc.
    // Every create costs one extra read (the get() of the referenced
    // studio_doc) so submissions can only ever land on live collect docs.
    // test (optional): the student's raw chosen option indices for the
    // linked test. Indicies only — no score, no key. The teacher's Results
    // view grades them against the live test page. A worksheet with zero
    // filled cells is still valid when the test itself was answered.
    function studioSubTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'total', 'answered', 'answers'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() <= 200
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.answered is number && t.answered >= 0 && t.answered <= 500
        && t.answers is list && t.answers.size() >= 1 && t.answers.size() <= 500
        && t.answers.all(x, x == null || (x is number && x >= 0 && x <= 20));
    }
    function studioSubFieldsOk(d) {
      return d.docId is string
        && d.docId.size() >= 10
        && d.docId.size() <= 100
        && d.docTitle is string
        && d.docTitle.size() <= 200
        && d.ownerUid is string
        && d.ownerUid.size() <= 100
        && d.kind in ['doc', 'sheet']
        && d.studentName is string
        && d.studentName.size() >= 1
        && d.studentName.size() <= 40
        && d.answers is map
        && d.answers.size() <= 400
        && (d.answers.size() >= 1
            || (d.keys().hasAny(['test'])
                && d.test is map
                && d.test.answered is number
                && d.test.answered >= 1))
        && (!(d.keys().hasAny(['test'])) || studioSubTestOk(d.test))
        && d.submittedAt is string
        && d.submittedAt.size() <= 40
        && get(/databases/$(database)/documents/studio_docs/$(d.docId)).data.mode == 'collect';
    }

    match /studio_submissions/{subId} {
      allow get: if isCmcTeacher()
        || (isVerifiedUser() && resource.data.studentUid == request.auth.uid);
      allow list: if isCmcTeacher();

      allow create: if (
          isVerifiedUser()
          && request.resource.data.studentUid == request.auth.uid
          && subId == (request.resource.data.docId + '__' + request.auth.uid)
          && studioSubFieldsOk(request.resource.data)
        ) || (
          request.auth == null
          && request.resource.data.studentUid == ''
          && subId.matches(request.resource.data.docId + '__guest_[a-zA-Z0-9]{8,20}')
          && studioSubFieldsOk(request.resource.data)
        );

      // Append-only: submissions are immutable once written.
      allow update, delete: if false;
    }

    // Default-deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
