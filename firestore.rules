rules_version = '2';

// Creative Minds Cambodia — production Firestore security rules.
//
// HOW TO DEPLOY (one-time, ~2 minutes — no CLI needed):
//   1. Open https://console.firebase.google.com → project "creative-minds-cambodia"
//   2. Build → Firestore Database → Rules tab  (database: "(default)")
//   3. Paste this entire file over the editor contents → click "Publish"
//
// ⚠️ REGRESSION FIX (Oct 2026): an earlier revision wrote
// `match /drill_attempts` and `match /teacher_chat` as bare collection
// paths. Firestore rules match DOCUMENT paths, not collection paths, so
// those blocks matched nothing — every read/write fell through to the
// default-deny wildcard, breaking the live ticker, chat wall and drill
// submissions with "Missing or insufficient permissions". A match path
// for a top-level collection MUST carry a document wildcard segment:
//   match /collection/{docId}        (that collection's documents)
//   match /collection/{document=**}  (documents + all subcollections)
//
// WHAT THESE RULES DO (and why):
//   - drill_attempts/{attemptId}: public read (the homepage ticker, game
//     leaderboard and dashboards list it anonymously via the REST API);
//     creates for SIGNED-IN users submitting their OWN uid (a signed-in
//     student cannot forge scores for classmates) PLUS a validated guest
//     branch scoped to the Kid 11 classroom pages (drillSource 'rfc3') —
//     empty studentUid, size/range-checked name & fields, no class
//     attribution — so homework and secure-quiz submissions sent with a
//     typed name + student ID in class are recorded too (Nov 2026). Scores are immutable
//     (no update/delete by clients). NEW (Nov 2026): private invite-test
//     results may NO LONGER be written here — they go to invite_attempts
//     (owner-private). The inviteMode guard keeps stale cached pages from
//     leaking test results into the public feed.
//   - invite_codes/{code} + invite_attempts/{attemptId} (Nov 2026): the
//     private homework/test result pipeline. The dashboard stamps each
//     teacher's personal invite code with their uid (invite_codes, create-once,
//     public read so student devices can copy the owner). Student submissions
//     land in invite_attempts stamped with that owner — verified against the
//     registry at create, so the stamp cannot be forged — and ONLY that
//     teacher can ever read them. Scores are handed to students by their own
//     teacher, never exposed to other teachers or the public.
//   - teacher_chat/{msgId}: RETIRED (Nov 2026) — replaced by the blog-style
//     `announcements` board. Kept publicly readable so old messages stay
//     reachable, but every write is denied: the chat UI is gone.
//   - announcements/{postId}: public read (blog-style board on the landing
//     page); create/update/delete ONLY for approved admins — the site owner
//     (isCmcAdmin) plus any UID listed in site_config/admins.uids.
//   - site_config/{configId}: public read, owner-only write. The admins doc
//     here is the approval allowlist the owner manages in-app, so approving
//     a new announcement admin never requires redeploying these rules.
//   - students/{uid}: each student can read/write only their own profile.
//   - classes/{classId} + enrollments: public read (code lookup /
//     dashboards), signed-in writes, students enroll themselves. DELETE is
//     owner-only: the class doc's teacherUid must match the caller, and
//     enrollment cleanup is allowed for the teacherUid stamped on each
//     enrollment doc at join time (or by the enrolled student themself —
//     "leave class"). No rules get() calls, so bulk cleanup in one pass
//     never hits the document-access limit.
//   - assessment_classes/{classId} (+ students subcollection): the Daily
//     Student Assessment Records workspace. TEACHERS ONLY — the signed-in
//     account's email must contain "edu" (the same heuristic RoleGate uses
//     site-wide). Replaces the retired Google Apps Script/Sheets backend,
//     whose "Anyone" web-app deployment let any visitor read or wipe
//     all records.
//   - Everything else: denied.
//
// EMAIL VERIFICATION GATE (Oct 2026): every account must verify its email
// address (Firebase sends the link at sign-up; sign-in is blocked until it
// is clicked). isVerifiedUser() enforces this server-side: unverified
// sessions can authenticate NOTHING except creating their own students/
// {uid} profile doc at sign-up. This is defense in depth — the client
// already refuses to hold or mint sessions for unverified accounts.
// ⚠️ PUBLISH REQUIRED: these rules take effect only after pasting this
// file into Firebase Console → Firestore → Rules and clicking Publish.
//
// VERIFIED against the live write shape (Oct 2026): every worksheet POST
// (biweek-planner, toefl-ibt, rfc2, rfc3, syntax-clash, writequest, the
// React submitScore module and CMC.submitDrill) sends integer scorePct
// 0-100, integer correctCount/totalCount >= 0, and studentUid matching
// the Bearer token's own uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // SITE-OWNER ADMIN GRANT (Oct 2026): the owner's account is admin of
    // the whole site, keyed by Firebase UID (immutable across email
    // changes; the uid is already public via the classes collection as
    // teacherUid). Email verification is still required. OR'd into
    // isCmcTeacher() so EVERY teacher gate opens for this account, and
    // isVerifiedTeacher() waives the teachers/{uid} allowlist doc for it.
    // The same UID is hardcoded client-side (src/lib/firebaseAuth.ts
    // ADMIN_UIDS) — keep the two in sync.
    function isCmcAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == '5iLvnjzmV8QY7WFZhyTq6PIgcI63';
    }

    // A signed-in account whose email contains "edu" — or the site-owner
    // admin account — that finished email verification. This is the same
    // heuristic the CMC app (RoleGate / firebaseAuth.detectRoleFromEmail)
    // uses to decide who is a teacher, hardened with the verification gate
    // and extended with the admin grant. RE2 has no look-around, so keep
    // this in sync with the app if the heuristic ever changes.
    //
    // The pattern tests the DOMAIN only (the part after the last "@"),
    // exactly like detectRoleFromEmail(): "you@school.edu.kh" passes,
    // "eduardo@gmail.com" does not. It used to test the whole address, so
    // any free mailbox with "edu" in the name was granted teacher access.
    function isCmcTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (request.auth.token.email.matches('.*@[^@]*[eE][dD][uU][^@]*')
            || isCmcAdmin());
    }

    // ADMIN TEACHER-VERIFICATION OVERRIDES (Nov 2026): `site_config/teacher_access`
    // holds two UID lists the site owner manages from the in-app
    // Admin → Users & Teacher Verification panel:
    //   approvedUids — teachers without a school (.edu) address (e.g. Gmail)
    //                  that the owner vouches for.
    //   revokedUids  — accounts whose teacher access was taken away.
    // The document is PUBLIC READ (clients resolve their own badge without a
    // token round-trip) and owner-only write (see site_config below). Both
    // helpers are pure functions over one cached get().
    function teacherAccessDoc() {
      return get(/databases/$(database)/documents/site_config/teacher_access).data;
    }
    function teacherAccessList(field) {
      return exists(/databases/$(database)/documents/site_config/teacher_access)
        && field in teacherAccessDoc()
        && request.auth.uid in teacherAccessDoc()[field];
    }
    function isAdminApprovedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && teacherAccessList('approvedUids')
        && !teacherAccessList('revokedUids');
    }
    function isRevokedTeacher() {
      return request.auth != null && teacherAccessList('revokedUids');
    }

    // A signed-in account that proved its email address by clicking the
    // verification link. Required for every student-reachable write.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    match /drill_attempts/{attemptId} {
      allow read: if true; // public scoreboard (ticker / leaderboard / dashboard)

      // PRIVATE-TEST GUARD (Nov 2026): invite-mode test results are
      // teacher-private and live in invite_attempts. Neither create branch
      // may smuggle an inviteMode doc into this PUBLIC collection — a stale
      // cached page that still posts here is denied and the attempt simply
      // stays in that student's offline queue until their browser picks up
      // the updated script.
      function notInviteMode() {
        return !('inviteMode' in request.resource.data)
          || request.resource.data.inviteMode == false;
      }

      // ACCOUNT REQUIRED (Nov 2026): guests may sample a couple of game
      // rounds, but nothing they do is recorded — every GAME attempt belongs
      // to a verified CMC account and is pinned to that account's own uid
      // (self-reported names and scores could pollute the public ticker).
      allow create: if notInviteMode()
        && isVerifiedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid is string
        && request.resource.data.studentName is string
        && request.resource.data.drillSlug is string
        && request.resource.data.drillTitle is string
        && request.resource.data.drillSource is string
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0;

      // KID 11 CLASSROOM BRANCH (restored): the standalone Kid 11 pages
      // (drillSource 'rfc3' — online homework + the Units 12–13 secure quiz)
      // are used live in class with a TYPED name + student ID; the quiz has
      // no account gate by design, and the homework pages post the same
      // shape when a session cannot be recovered. This validated guest
      // branch — EMPTY studentUid, 1–40 char name, rfc3 source only, ranged
      // integer scores, no class attribution — is what those pages were
      // built against (and what this file's header documents). When it was
      // dropped, Kid 11 submissions were denied at the door: the student
      // saw "Submitted", the teacher saw nothing. Scoped to 'rfc3' so game
      // scores still require a verified account.
      allow create: if notInviteMode()
        && request.resource.data.studentUid == ''
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 40
        && request.resource.data.drillSlug is string
        && request.resource.data.drillSlug.size() <= 64
        && request.resource.data.drillTitle is string
        && request.resource.data.drillTitle.size() <= 160
        && request.resource.data.drillSource == 'rfc3'
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalCount <= 500
        && (!('classId' in request.resource.data)
          || request.resource.data.classId == null
          || (request.resource.data.classId is string
            && request.resource.data.classId.size() <= 40));

      // Score history is append-only — nobody rewrites results.
      allow update, delete: if false;
    }

    // ── Private invite-test results (Nov 2026) ──
    //
    // The simple share flow: the dashboard gives every teacher a personal
    // invite code; a test link looks like tests/<slug>.html?invite=CODE.
    // Results are TEST SCORES, so per the site's privacy model they are
    // visible ONLY to the owning teacher — handed to students by their
    // teacher, never to classmates, other teachers, or the public feed.
    //
    // invite_codes/{code}: the registry binding a code to its owner. The
    // dashboard creates it (create-once) the moment the teacher's panel
    // opens. Public READ so a student's browser can copy the owner uid onto
    // their submission without signing in; only verified teachers write.
    match /invite_codes/{code} {
      allow read: if true;
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && code.size() >= 8
        && code.size() <= 32;
      // Re-stamping an existing code is owner-only — a stolen code cannot
      // be re-pointed at a different teacher's account.
      allow update: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    // invite_attempts/{attemptId}: one student's test attempt (score +
    // full answer sheet + integrity counters). ACCOUNT REQUIRED: shared and
    // invite links need a signed-in, email-verified CMC account — the
    // ownership stamp must additionally match the registry's owner for the
    // used code, so results can neither be forged nor misdirected. Reads are
    // strictly owner-only; the list query MUST filter teacherUid ==
    // request.auth.uid. Append-only like every result collection.
    match /invite_attempts/{attemptId} {
      allow read: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 3
        && request.resource.data.inviteCode.size() <= 32
        && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.teacherUid == request.resource.data.teacherUid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 60
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() <= 24
        && request.resource.data.drillSlug is string
        && request.resource.data.drillSlug.size() >= 1
        && request.resource.data.drillSlug.size() <= 80
        && request.resource.data.drillTitle is string
        && request.resource.data.drillTitle.size() >= 1
        && request.resource.data.drillTitle.size() <= 120
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.correctCount <= 10000
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalCount <= 10000
        && (!('classId' in request.resource.data) || request.resource.data.classId == null)
        // SEALED TESTS (Nov 2026): the test pages no longer contain their
        // answer keys, so a student's browser cannot grade. It sends the raw
        // answer sheet (`sheet`, JSON text) with sealed == true and the
        // teacher's dashboard grades it. Both are optional so attempts from
        // a stale cached page are still accepted; when present they are
        // type- and size-checked.
        && (!('sealed' in request.resource.data) || request.resource.data.sealed is bool)
        && (!('sheet' in request.resource.data)
            || (request.resource.data.sheet is string
                && request.resource.data.sheet.size() <= 20000));

      // Result history is append-only — nobody rewrites a submission.
      allow update, delete: if false;
    }

    match /teacher_chat/{msgId} {
      allow read: if true; // retired chat wall — old messages stay readable
      // Retired Nov 2026: replaced by /announcements. No client writes it.
      allow create, update, delete: if false;
    }

    // ANNOUNCEMENT BOARD (Nov 2026): blog-style replacement for teacher_chat.
    // Everyone can read; only APPROVED ADMINS can publish, edit, pin or
    // delete. Approval = the site-owner UID (isCmcAdmin) or an entry in the
    // site_config/admins allowlist doc, which the owner manages in-app.
    function isCmcApprovedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isCmcAdmin()
            || (exists(/databases/$(database)/documents/site_config/admins)
                && request.auth.uid in
                    get(/databases/$(database)/documents/site_config/admins).data.get('uids', [])));
    }

    // A post may carry a video address and a link (Nov 2026). Both are
    // optional; when present each must be a plain http(s) address, so a
    // post can never hand a reader a javascript: or data: link.
    function announcementExtrasOk(d) {
      return d.get('videoUrl', '') is string
        && d.get('videoUrl', '').size() <= 2000
        && d.get('videoUrl', '').matches('(https?://.+)?')
        && d.get('linkUrl', '') is string
        && d.get('linkUrl', '').size() <= 2000
        && d.get('linkUrl', '').matches('(https?://.+)?')
        && d.get('linkLabel', '') is string
        && d.get('linkLabel', '').size() <= 80;
    }

    match /announcements/{postId} {
      allow read: if true; // public blog-style board

      allow create: if isCmcApprovedAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000 // downscaled data URL; keeps docs under 1 MiB
        && request.resource.data.pinned is bool
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.authorEmail is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && announcementExtrasOk(request.resource.data);

      // Collegial editing, like assessment_classes: any approved admin can
      // edit/pin/delete any post. Writes are stamped with authorUid at
      // create time, so authorship stays attributable.
      allow update: if isCmcApprovedAdmin() && announcementExtrasOk(request.resource.data);
      allow delete: if isCmcApprovedAdmin();
    }

    match /site_config/{configId} {
      allow read: if true; // approved admins read the list to check their own status
      allow write: if isCmcAdmin(); // only the owner grants/revokes admin access
    }

    // CMC USER DIRECTORY (Nov 2026): one document per account recording the
    // Student / Teacher / General-user choice made at sign-up, plus the
    // email / verification state the admin panel shows. The owner of the
    // doc writes it (create happens immediately at sign-up while the token
    // is still unverified; updates need a verified email). LIST is
    // admin-only — a verified teacher must never enumerate accounts.
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.accountType in ['student', 'teacher', 'user'];
      allow get, update: if isVerifiedUser() && request.auth.uid == uid;
      allow list: if isCmcAdmin();
      // Nobody edits or deletes someone else's record; deletions only by the
      // owner account itself (account cleanup) and the owner/admin.
      allow delete: if isCmcAdmin() || (isVerifiedUser() && request.auth.uid == uid);
    }

    // ── PROFILE PICTURE (Nov 2026) ──
    // One small document per account: a built-in avatar id, or a photo the
    // browser has already shrunk to a 160 px square (a base64 data: URL, a
    // few kilobytes — src/lib/avatar.ts). Many users are children, so the
    // picture is PRIVATE: only the account itself reads it. The site owner
    // can read and remove one (moderation) but cannot write one.
    match /user_avatars/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isCmcAdmin());
      allow list: if isCmcAdmin();
      allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'photo', 'preset', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.kind in ['photo', 'preset']
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 90000
        && request.resource.data.preset is string
        && request.resource.data.preset.size() <= 40
        && ((request.resource.data.kind == 'preset'
              && request.resource.data.photo == ''
              && request.resource.data.preset.matches('^[a-z0-9-]{1,40}$'))
            || (request.resource.data.kind == 'photo'
              && request.resource.data.preset == ''
              && request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+=*$')));
      allow delete: if isVerifiedUser() && (request.auth.uid == uid || isCmcAdmin());
    }

    match /students/{uid} {
      // CREATE with just sign-in: the signup flow writes the profile doc
      // while the brand-new (still unverified) auth context exists. Every
      // other access — read included — requires a verified email.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isVerifiedUser() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if true; // class-code lookup + dashboards
      // Only verified teachers create classes; students join by code.
      allow create: if isVerifiedTeacher();
      // Owner-only update, and teacherUid is immutable: without this any
      // verified account could re-stamp teacherUid on someone else's class
      // and then pass the owner-only delete below.
      allow update: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid;
      // Owner-only delete: `resource` is the class doc being removed, and
      // every class doc carries teacherUid (createClass stamps it), so this
      // costs no extra reads. Delete also implicitly drops the class code
      // from join lookups (getClassByCode queries this collection).
      allow delete: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid;

      match /enrollments/{studentUid} {
        allow read: if true;
        allow create, update: if isVerifiedUser() && request.auth.uid == studentUid;
        // Delete: the enrolled student themself (leave class), or the class
        // owner (teacherUid was stamped on the enrollment doc at join time).
        // Docs created before that stamping began have no teacherUid —
        // resource.data.teacherUid is then null and the comparison denies,
        // which is safe: they remain harmless orphans under a deleted class.
        allow delete: if isVerifiedUser()
          && (request.auth.uid == studentUid
              || resource.data.teacherUid == request.auth.uid);
      }
    }

    // Daily Student Assessment Records — each teacher's own workspace.
    //
    // PRIVATE PER TEACHER (owner decision, Nov 2026: "teachers can not see
    // other teachers' assessment records for their students"). A class and
    // every student record under it are readable and writable only by the
    // teacher who owns the class (teacherUid). It used to be "any teacher".
    //   · A LIST query must filter on teacherUid == the caller (or on
    //     teacherEmail == the caller's address, the account-recovery path in
    //     assessmentDb.listAssessmentClasses); an unfiltered list is refused.
    //   · teacherEmail also opens the class to the same person under a
    //     re-created account, who may then re-stamp teacherUid with their
    //     own uid — and with nobody else's.
    //   · The site owner (isCmcAdmin) keeps access for support.
    // Classes are archived, never deleted, from the client.
    function ownsAssessmentClassDoc(c) {
      return c.teacherUid == request.auth.uid
        || ('teacherEmail' in c
            && c.teacherEmail is string
            && c.teacherEmail.size() > 0
            && c.teacherEmail == request.auth.token.email)
        || isCmcAdmin();
    }
    function ownsAssessmentClass(classId) {
      return ownsAssessmentClassDoc(
        get(/databases/$(database)/documents/assessment_classes/$(classId)).data);
    }
    match /assessment_classes/{classId} {
      allow read: if isCmcTeacher() && ownsAssessmentClassDoc(resource.data);
      allow create: if isCmcTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid is string;
      allow update: if isCmcTeacher()
        && ownsAssessmentClassDoc(resource.data)
        && (request.resource.data.teacherUid == resource.data.teacherUid
            || request.resource.data.teacherUid == request.auth.uid);
      allow delete: if false;

      match /students/{studentId} {
        allow read, write: if isCmcTeacher() && ownsAssessmentClass(classId);
      }
    }

    // ── SCHOOL ROSTER + REGISTRATION (Nov 2026) ──
    //
    // Ties an account to a real student on a class list, so every score,
    // homework and attendance mark can land on one student record. Classes
    // and their lists live in assessment_classes (teachers only, above).
    //
    //   roster_seats/{seatKey}  one per student on a PUBLISHED class list.
    //       The id is a SHA-256 of the school ID and the name
    //       (src/lib/roster.ts seatKeyOf). A student can GET their own seat
    //       because they know both; nobody but a teacher can LIST seats, so
    //       the class list cannot be browsed.
    //   student_links/{uid}     the seat an account is registered as.
    //
    // A registration is ONE commit of two writes, each checked against the
    // other with getAfter():
    //   · the seat takes the account — only a free seat, only the caller's
    //     own uid, only the four claim fields change, and the caller's link
    //     must point at this seat when the commit lands;
    //   · the account takes the seat — a link is created once, under the
    //     caller's uid, and the seat must name the caller when the commit
    //     lands.
    // A link cannot be changed or removed by its student, so an account holds
    // one seat for good; a seat names one account. A teacher can release a
    // seat (wrong person registered) and re-publish the list.
    //
    // PRIVATE PER TEACHER, like the class lists: a teacher lists, creates,
    // changes and withdraws only the seats stamped with their own uid, and
    // touches a link only when the seat it points at is theirs. Anyone who
    // knows a seat's key (school ID + name) can still GET that one seat.
    function ownsSeatDoc(d) {
      return d.teacherUid == request.auth.uid || isCmcAdmin();
    }
    match /roster_seats/{seatKey} {
      allow get: if isVerifiedUser();
      allow list: if isCmcTeacher() && ownsSeatDoc(resource.data);
      allow create: if isCmcTeacher() && ownsSeatDoc(request.resource.data);
      allow delete: if isCmcTeacher() && ownsSeatDoc(resource.data);
      allow update: if (isCmcTeacher()
            && ownsSeatDoc(resource.data)
            && ownsSeatDoc(request.resource.data))
        || (isVerifiedUser()
            && resource.data.claimedBy == null
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['claimedBy', 'claimedEmail', 'claimedName', 'claimedAt'])
            && getAfter(/databases/$(database)/documents/student_links/$(request.auth.uid)).data.seatKey == seatKey);
    }

    match /student_links/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isCmcTeacher());
      allow list: if isCmcAdmin();
      allow create: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.seatKey is string
        && request.resource.data.keys().hasOnly(['uid', 'seatKey', 'linkedAt'])
        && getAfter(/databases/$(database)/documents/roster_seats/$(request.resource.data.seatKey)).data.claimedBy == uid;
      // the teacher of the seat the link points at (as it stood before this write)
      // (a link left pointing at no seat at all may be cleared by any teacher)
      allow update, delete: if isCmcTeacher()
        && (!exists(/databases/$(database)/documents/roster_seats/$(resource.data.seatKey))
            || ownsSeatDoc(get(/databases/$(database)/documents/roster_seats/$(resource.data.seatKey)).data));
    }

    // ── Private bi-weekly test system (Option A: teacher-side grading) ──
    //
    // PRIVACY MODEL (Nov 2026): private-test data is visible ONLY to the
    // teacher who owns the class. Scores are handed to students by their own
    // teacher — never shown to other teachers, other classes, or the public.
    // Ownership = a teacherUid field stamped on every document at write time
    // and verified against the signed-in token's uid:
    //   - test_assignments: stamped at create (rules enforce owner writes).
    //   - test_submissions: the student page copies teacherUid from the
    //     assignment it already reads; create verifies it matches the
    //     assignment's owner, so it cannot be forged.
    //   - test_keys / test_scores: stamped by the dashboard when the owner
    //     installs the key / grades. A second teacher can neither read nor
    //     silently overwrite them.
    // LIST queries must filter teacherUid == request.auth.uid — the rules
    // engine rejects unconstrained queries (403) instead of leaking rows.
    // Docs created BEFORE stamping began ("legacy": no teacherUid field)
    // remain readable by any verified teacher via single-doc GETs until the
    // owner re-installs the key / re-grades, which claims the doc.
    //
    // Flow: teacher creates test_assignments/{id} for a class → students open
    // the private (answer-free) test page, sign in, and POST raw answers to
    // test_submissions/{assignmentId}__{studentUid} → the teacher dashboard
    // grades locally against test_keys/{testId} and caches scores in
    // test_scores/{submissionId}. Students can NEVER read the key, any score,
    // or anyone else's submission.
    //
    // teachers/{uid}: append-only allowlist that hardens the "email contains
    // edu" heuristic for the sensitive collections (answer keys!). Any edu
    // account may register itself ONCE (create), after which the doc is
    // immutable. Sensitive collections require BOTH the edu heuristic AND an
    // allowlist entry. To tighten further, replace isCmcTeacher() inside
    // isVerifiedTeacher() with a hardcoded email check.

    match /teachers/{uid} {
      allow read: if request.auth != null; // role checks only; non-sensitive
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isCmcTeacher();
      allow update, delete: if false; // allowlist is append-only
    }

    // VERIFIED TEACHER (Nov 2026): the owner's admin grant, OR the account
    // was approved in Admin → Users & Teachers (which covers Gmail teachers),
    // OR it passes the school-email heuristic AND registered in the
    // teachers/{uid} allowlist. An admin revocation always wins: a revoked
    // account loses teacher access even with an .edu address.
    function isVerifiedTeacher() {
      return request.auth != null
        && (isCmcAdmin()
            || (isAdminApprovedTeacher())
            || (isCmcTeacher()
                && !isRevokedTeacher()
                && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))));
    }

    // Test shell metadata (title, groups, question count). NO answers here.
    match /biweekly_tests/{testId} {
      allow read: if true;
      allow create, update: if isVerifiedTeacher();
      allow delete: if false;
    }

    // THE answer key. The single most protected collection on the site.
    // Owner-only: another verified teacher can neither read nor overwrite a
    // key stamped to someone else. Legacy keys (pre-stamp) stay readable
    // until the owner re-installs — the re-install claims the doc.
    match /test_keys/{testId} {
      allow read: if isVerifiedTeacher()
        && (resource.data.teacherUid == request.auth.uid
            || !('teacherUid' in resource.data));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (!('teacherUid' in resource.data)
            || resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
    }

    // ANSWER SEAL (Nov 2026): the public bi-weekly test pages carry their
    // answers ENCRYPTED (scripts/seal_tests.mjs). The one private key that
    // opens them is the document teacher_secrets/answer-seal. This rule IS
    // the protection: a verified teacher may fetch that document by name;
    // nobody may list the collection, and students and signed-out visitors
    // get nothing. Only the site owner can install or replace the key (from
    // the dashboard: Bi-Weekly Tests → Answer protection).
    match /teacher_secrets/{secretId} {
      allow get: if isVerifiedTeacher();
      allow list: if false;
      allow create, update: if isCmcAdmin()
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 20
        && request.resource.data.key.size() <= 200;
      allow delete: if false;
    }

    // One assignment = test + class + window. Reads: the owning teacher, or
    // an enrolled student (the private page loads the window/duration from
    // here before accepting answers).
    match /test_assignments/{assignmentId} {
      allow read: if request.auth != null
        && (resource.data.teacherUid == request.auth.uid
            || (isVerifiedUser()
                && resource.data.classId is string
                && exists(/databases/$(database)/documents/classes/$(resource.data.classId)/enrollments/$(request.auth.uid))));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      // PATCH replaces the whole document, so updates must carry the full
      // owner-stamped doc — ownership can never be moved or wiped.
      allow update: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    // Raw student answers. Doc ID is "{assignmentId}__{studentUid}" so the
    // create-once rule IS the one-attempt rule: a second create with the same
    // ID fails at the database level, not just in the UI. Students may GET
    // their own doc (resume UX) but can never list or read anyone else's.
    // LIST (the dashboard scoreboard) requires the query to filter
    // teacherUid == auth.uid, so a teacher cannot enumerate another
    // teacher's submissions even by guessing assignment ids.
    match /test_submissions/{docId} {
      allow get: if (isVerifiedUser()
            && resource.data.studentUid == request.auth.uid)
        || (isVerifiedTeacher()
            && (resource.data.teacherUid == request.auth.uid
                || !('teacherUid' in resource.data)));
      allow list: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;

      allow create: if isVerifiedUser()
        && request.auth.uid is string
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.testId is string
        && request.resource.data.classId is string
        && request.resource.data.studentName is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.answers is map
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 300
        && request.resource.data.integrity is map
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && docId == (request.resource.data.assignmentId + '__' + request.auth.uid)
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.opensAt <= request.time
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.closesAt >= request.time;

      // Append-only: nobody (not even the teacher) rewrites a submission.
      allow update, delete: if false;
    }

    // Computed scores + per-skill breakdown + most-missed data.
    // Owner-only: visible solely to the teacher stamped on the doc when the
    // dashboard graded it. Students never read scores here — their teacher
    // hands them their result personally. Legacy scores (pre-stamp) stay
    // readable until the owner re-grades, which claims the doc.
    match /test_scores/{docId} {
      allow read: if isVerifiedTeacher()
        && (resource.data.teacherUid == request.auth.uid
            || !('teacherUid' in resource.data));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (!('teacherUid' in resource.data)
            || resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
    }

    // SERVER-AGGREGATED TICKER STATS (Blaze plan, Oct 2026): the scheduled
    // rollupTicker Cloud Function (functions/index.js) rewrites
    // ticker_stats/latest every 5 minutes with the homepage ticker's stats.
    // Public read lets every visitor's ticker fetch ONE pre-aggregated
    // document per poll instead of running the week-window + two count()
    // queries itself — per-visitor cost drops to a single read no matter how
    // busy the week is. Writes are DENIED to all clients: the doc is
    // maintained exclusively by the Cloud Function, whose Admin SDK access
    // bypasses security rules entirely.
    match /ticker_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ONLINE CHESS ROOMS (Nov 2026): the realtime table for Arena Chess 3D
    // online duels. One document per room (5-letter code as the doc id):
    // the host creates it, a guest claims the open seat, then both players
    // append SAN moves. BOTH clients replay the move list through chess.js
    // and validate every transition locally — these rules enforce identity
    // and document shape, not move legality (a hostile writer could inject
    // nonsense into their OWN room; it can never touch anyone else's, and
    // the replaying client simply shows the position the moves produce).
    // All writes require a verified account; reads too, so room codes are
    // only reachable by real CMC members.
    match /chess_rooms/{roomId} {
      allow read: if isVerifiedUser();

      // Create: only your own room, brand-new and empty, code == doc id.
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.hostColor in ['w', 'b']
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.result == null
        && request.resource.data.drawOffer == null
        && request.resource.data.gameNo == 1;

      // Join: a verified player claims the open guest seat. Afterwards,
      // only the two seated players may touch the room (move appends,
      // resign, draw offers, rematch gameNo bump). Firestore cannot verify
      // chess legality — that is the client replay's job — but identity is
      // hard-enforced: nobody else can read, join or disturb the table.
      allow update: if isVerifiedUser()
        && ((resource.data.guestUid == null
             && request.resource.data.guestUid == request.auth.uid)
            || request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid);

      // Cleanup: the host can take a dead table down.
      allow delete: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;
    }


    // ONLINE MAFIA ROOMS (Nov 2026): the hidden-information table for Mafia
    // Noir (public/mafia.html, Brain Lounge bay 04) — the Firestore transport
    // that replaced the WebSocket server the upload assumed. Same identity
    // discipline as chess_rooms: verified players only, host owns the doc.
    // Two subcollections chess never needed, because mafia is HIDDEN-info:
    //   views/{uid}  — that player's PERSONAL view (own role, syndicate team,
    //                  detective files, channel-filtered chat). Readable ONLY
    //                  by that player; the host device writes them all. A
    //                  town player's view never carries another player's role.
    //   actions/{uid} — night action / ballot / chat / heartbeat. Players
    //                  write only their own; the host reads them to resolve
    //                  the phase and validates eligibility client-side.
    // The authoritative engine state is mirrored into the room doc's .engine
    // field AES-GCM-ENCRYPTED — the key lives only in the host's localStorage
    // — so even the room doc (readable by every verified player, like
    // chess_rooms) never carries a readable role.
    match /mafia_rooms/{roomId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.status == 'open'
        && request.resource.data.engine is string;
      allow update: if isVerifiedUser()
        && request.auth.uid == resource.data.hostUid;
      allow delete: if isVerifiedUser()
        && request.auth.uid == resource.data.hostUid;

      match /views/{uid} {
        allow read: if isVerifiedUser() && request.auth.uid == uid;
        allow create, update: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
        allow delete: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
      }
      match /actions/{uid} {
        allow read: if isVerifiedUser()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid);
        allow create, update: if isVerifiedUser() && request.auth.uid == uid;
        allow delete: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
      }
    }

    // ONLINE WORD CREATOR ROOMS (Nov 2026): the two-to-four-seat word duel
    // (public/arcade/word-creator/index.html, Brain Lounge bay 05).
    //
    // HOW A ROOM WORKS. The room doc holds a seed, the seats in joining order,
    // and an append-only move log. Nothing else is the truth: every device
    // deals the bag from the seed and replays the log through the same engine
    // (public/arcade/word-creator/online.js), so board, racks, bag, scores and
    // whose turn it is come out identical everywhere, also after a reload.
    // Racks are never written down. `cells`, `scores`, `bagSize` and `result`
    // are a convenience copy for lobbies and spectators; no device plays from
    // them, so a tampered copy cannot change a match.
    //
    // Readable by any verified player (rooms are opened BY code, like
    // chess_rooms). There are exactly two kinds of write after create:
    //   JOIN — somebody without a seat appends their own seat to a waiting
    //          room that still has one free. Nothing else may change, except
    //          that the room turns to 'playing' when the last seat fills.
    //   MOVE — the seat whose turn it is appends ONE move carrying its own
    //          uid. Earlier moves and all seats must come back untouched.
    //          The turn is not a free field: it is the log length modulo the
    //          seat count, before and after. The mover may close the match
    //          ('finished' + result) with the move that ends it.
    // The host has no extra powers once the room exists. Every client write
    // also carries an updateTime precondition, so two writes made from the
    // same state cannot both land.
    match /word_creator_rooms/{roomId} {
      // Seats are looked up by position: a room has at most four.
      function wcSeated(seats, uid) {
        return (seats.size() > 0 && seats[0].uid == uid)
          || (seats.size() > 1 && seats[1].uid == uid)
          || (seats.size() > 2 && seats[2].uid == uid)
          || (seats.size() > 3 && seats[3].uid == uid);
      }

      allow read: if isVerifiedUser();

      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.seed is string
        && request.resource.data.seed.size() >= 8
        && request.resource.data.seatsWanted is int
        && request.resource.data.seatsWanted >= 2
        && request.resource.data.seatsWanted <= 4
        && request.resource.data.status == 'waiting'
        && request.resource.data.seats is list
        && request.resource.data.seats.size() == 1
        && request.resource.data.seats[0].uid == request.auth.uid
        && request.resource.data.seats[0].host == true
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.turn == 0
        && request.resource.data.result == null;

      allow update: if isVerifiedUser()
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.seatsWanted == resource.data.seatsWanted
        && request.resource.data.seats is list
        && request.resource.data.moves is list
        && (
          // JOIN
          (
            resource.data.status == 'waiting'
            && !wcSeated(resource.data.seats, request.auth.uid)
            && resource.data.seats.size() < resource.data.seatsWanted
            && request.resource.data.seats.size() == resource.data.seats.size() + 1
            && request.resource.data.seats[0:resource.data.seats.size()] == resource.data.seats
            && request.resource.data.seats[resource.data.seats.size()].uid == request.auth.uid
            && request.resource.data.seats[resource.data.seats.size()].host == false
            && request.resource.data.moves.size() == 0
            && request.resource.data.turn == 0
            && request.resource.data.result == null
            && (
              (request.resource.data.seats.size() == resource.data.seatsWanted
                && request.resource.data.status == 'playing')
              || (request.resource.data.seats.size() < resource.data.seatsWanted
                && request.resource.data.status == 'waiting')
            )
          )
          // MOVE
          || (
            resource.data.status == 'playing'
            && request.resource.data.seats == resource.data.seats
            && request.resource.data.moves.size() == resource.data.moves.size() + 1
            && request.resource.data.moves[0:resource.data.moves.size()] == resource.data.moves
            && resource.data.seats[resource.data.moves.size() % resource.data.seats.size()].uid == request.auth.uid
            && request.resource.data.moves[resource.data.moves.size()].uid == request.auth.uid
            && request.resource.data.turn == request.resource.data.moves.size() % resource.data.seats.size()
            && (
              (request.resource.data.status == 'playing' && request.resource.data.result == null)
              || (request.resource.data.status == 'finished' && request.resource.data.result != null)
            )
          )
        );

      // Cleanup: anyone seated at the table may take it down.
      allow delete: if isVerifiedUser()
        && wcSeated(resource.data.seats, request.auth.uid);
    }

    // ── STUDIO SHARED DOCS & WORKSHEETS (Nov 2026) ──
    //
    // The Studio page (studio/) can publish a Docs or Excel document to a
    // live share link (?doc=<id>). Two modes:
    //   view    — everyone with the link sees a read-only copy
    //   collect — students open the link, fill the teacher-marked input
    //             cells (sheets) or their own copy of the document (docs),
    //             and press Submit; answers land in studio_submissions.
    //
    // studio_docs/{docId}: document id is an unguessable Firestore auto-ID,
    // so share links work exactly by knowing the link. Content is classroom
    // material, not secrets → public read, like biweekly_tests.
    // Create/update: teachers only (the same edu-email heuristic the app
    // uses site-wide, hardened with email verification). Update is
    // owner-only (republishing your own doc; kind can never change so a
    // doc can't be morphed into a different shape after the fact).
    // Delete: owner-only, so a teacher can remove a mis-shared link.
    // Size: the doc field is capped (600 KB) and sheets list capped (12);
    // Firestore's own 1 MiB per-document limit is the hard backstop.
    // linkedTest (optional, top-level): a student-safe copy of a bi-week
    // test — questions only. The key whitelist below makes it IMPOSSIBLE to
    // publish an answer field inside linkedTest, even from a tampered
    // client: keys must be exactly {slug,title,kicker,instructions,
    // transcript,minutes,groups,questions,audios,total} and each question
    // exactly {g,i,p,c,m}. Grading uses the live test page at Results time
    // (teacher-only), so the key never enters the database at all.
    function linkedTestQuestionOk(q) {
      return q is map
        && q.keys().hasOnly(['g', 'i', 'p', 'c', 'm'])
        && q.g is string && q.g.size() >= 1 && q.g.size() <= 100
        && q.i is number && q.i >= 0 && q.i <= 500
        && q.p is string && q.p.size() >= 1 && q.p.size() <= 2000
        && q.c is list && q.c.size() >= 2 && q.c.size() <= 12
        && q.c.all(ch, ch is string && ch.size() >= 0 && ch.size() <= 2000)
        && (q.m is bool || q.m == null);
    }
    function linkedTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'kicker', 'instructions', 'transcript', 'minutes', 'groups', 'questions', 'audios', 'total'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 200
        && t.kicker is string && t.kicker.size() <= 200
        && t.instructions is string && t.instructions.size() <= 4000
        && t.transcript is string && t.transcript.size() <= 8000
        && t.minutes is number && t.minutes >= 0 && t.minutes <= 300
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.groups is list && t.groups.size() >= 1 && t.groups.size() <= 50
        && t.groups.all(g, g is map && g.keys().hasOnly(['id', 'title', 'dirs'])
          && g.id is string && g.id.size() >= 1 && g.id.size() <= 100
          && g.title is string && g.title.size() <= 300
          && g.dirs is string && g.dirs.size() <= 600)
        && t.questions is list && t.questions.size() >= 1 && t.questions.size() <= 500
        && t.questions.all(linkedTestQuestionOk)
        && t.audios is list && t.audios.size() <= 20
        && t.audios.all(a, a is map && a.keys().hasOnly(['label', 'src'])
          && a.label is string && a.label.size() <= 300
          && a.src is string && a.src.size() <= 300);
    }
    function studioDocFieldsOk(d) {
      return d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 200
        && d.kind in ['doc', 'sheet']
        && d.mode in ['view', 'collect']
        && d.ownerUid == request.auth.uid
        && d.ownerName is string
        && d.ownerName.size() >= 1
        && d.ownerName.size() <= 60
        && d.createdAt is string
        && d.createdAt.size() <= 40
        && d.updatedAt is string
        && d.updatedAt.size() <= 40
        && d.revision is number
        && d.revision >= 1
        && d.revision <= 10000
        && d.data is map
        && (!(d.keys().hasAny(['linkedTest'])) || linkedTestOk(d.linkedTest))
        && ((d.kind == 'doc'
             && d.data.doc is string
             && d.data.doc.size() <= 600000
             && d.data.docHeader is string
             && d.data.docHeader.size() <= 60000
             && d.data.docFooter is string
             && d.data.docFooter.size() <= 60000)
           || (d.kind == 'sheet'
             && d.data.sheets is list
             && d.data.sheets.size() >= 1
             && d.data.sheets.size() <= 12));
    }

    match /studio_docs/{docId} {
      allow read: if true; // share links; content is classroom material

      allow create: if isCmcTeacher() && studioDocFieldsOk(request.resource.data);

      // Republish after edits: owner-only, shape-preserving (kind stays).
      allow update: if isCmcTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == resource.data.kind
        && studioDocFieldsOk(request.resource.data);

      allow delete: if isCmcTeacher() && resource.data.ownerUid == request.auth.uid;

      // "My published docs" dashboard in the Share dialog. The list itself
      // is teacher-only; the where('ownerUid') equality is enforced by the
      // client and the collection is publicly readable anyway.
      allow list: if isCmcTeacher();
    }

    // studio_submissions/{subId}: student answers for a collect worksheet.
    // Append-only (no update/delete for anyone — like test_submissions).
    // ACCOUNT REQUIRED: the doc id pins ONE attempt per account per
    // worksheet — "{docId}__{studentUid}", create-once, second submit
    // fails at the database level (the client surfaces it as 409). No
    // anonymous rows exist any more.
    // Reading results: teachers only. Students may GET their own doc.
    // Every create costs one extra read (the get() of the referenced
    // studio_doc) so submissions can only ever land on live collect docs.
    // test (optional): the student's raw chosen option indices for the
    // linked test. Indicies only — no score, no key. The teacher's Results
    // view grades them against the live test page. A worksheet with zero
    // filled cells is still valid when the test itself was answered.
    function studioSubTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'total', 'answered', 'answers'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() <= 200
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.answered is number && t.answered >= 0 && t.answered <= 500
        && t.answers is list && t.answers.size() >= 1 && t.answers.size() <= 500
        && t.answers.all(x, x == null || (x is number && x >= 0 && x <= 20));
    }
    function studioSubFieldsOk(d) {
      return d.docId is string
        && d.docId.size() >= 10
        && d.docId.size() <= 100
        && d.docTitle is string
        && d.docTitle.size() <= 200
        && d.ownerUid is string
        && d.ownerUid.size() <= 100
        && d.kind in ['doc', 'sheet']
        && d.studentName is string
        && d.studentName.size() >= 1
        && d.studentName.size() <= 40
        && d.answers is map
        && d.answers.size() <= 400
        && (d.answers.size() >= 1
            || (d.keys().hasAny(['test'])
                && d.test is map
                && d.test.answered is number
                && d.test.answered >= 1))
        && (!(d.keys().hasAny(['test'])) || studioSubTestOk(d.test))
        && d.submittedAt is string
        && d.submittedAt.size() <= 40
        && get(/databases/$(database)/documents/studio_docs/$(d.docId)).data.mode == 'collect';
    }

    match /studio_submissions/{subId} {
      allow get: if isCmcTeacher()
        || (isVerifiedUser() && resource.data.studentUid == request.auth.uid);
      allow list: if isCmcTeacher();

      // ACCOUNT REQUIRED (Nov 2026): collect-worksheet answers need a
      // signed-in, verified CMC account pinned to that account's uid — the
      // anonymous guest branch is gone.
      allow create: if isVerifiedUser()
        && request.resource.data.studentUid == request.auth.uid
        && subId == (request.resource.data.docId + '__' + request.auth.uid)
        && studioSubFieldsOk(request.resource.data);

      // Append-only: submissions are immutable once written.
      allow update, delete: if false;
    }

    // Default-deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
