rules_version = '2';

// Creative Minds Cambodia — production Firestore security rules.
//
// HOW TO DEPLOY (one-time, ~2 minutes — no CLI needed):
//   1. Open https://console.firebase.google.com → project "creative-minds-cambodia"
//   2. Build → Firestore Database → Rules tab  (database: "(default)")
//   3. Paste this entire file over the editor contents → click "Publish"
//
// ⚠️ REGRESSION FIX (Oct 2026): an earlier revision wrote
// `match /drill_attempts` and `match /teacher_chat` as bare collection
// paths. Firestore rules match DOCUMENT paths, not collection paths, so
// those blocks matched nothing — every read/write fell through to the
// default-deny wildcard, breaking the live ticker, chat wall and drill
// submissions with "Missing or insufficient permissions". A match path
// for a top-level collection MUST carry a document wildcard segment:
//   match /collection/{docId}        (that collection's documents)
//   match /collection/{document=**}  (documents + all subcollections)
//
// WHAT THESE RULES DO (and why):
//   - drill_attempts/{attemptId}: public read (the homepage ticker, game
//     leaderboard and dashboards list it anonymously via the REST API);
//     creates only for SIGNED-IN users submitting their OWN uid — a
//     signed-in student cannot forge scores for classmates; scores are
//     immutable (no update/delete by clients).
//   - teacher_chat/{msgId}: public read, signed-in create, immutable.
//   - students/{uid}: each student can read/write only their own profile.
//   - classes/{classId} + enrollments: public read (code lookup /
//     dashboards), signed-in writes, students enroll themselves. DELETE is
//     owner-only: the class doc's teacherUid must match the caller, and
//     enrollment cleanup is allowed for the teacherUid stamped on each
//     enrollment doc at join time (or by the enrolled student themself —
//     "leave class"). No rules get() calls, so bulk cleanup in one pass
//     never hits the document-access limit.
//   - assessment_classes/{classId} (+ students subcollection): the Daily
//     Student Assessment Records workspace. TEACHERS ONLY — the signed-in
//     account's email must contain "edu" (the same heuristic RoleGate uses
//     site-wide). Replaces the retired Google Apps Script/Sheets backend,
//     whose "Anyone" web-app deployment let any visitor read or wipe
//     all records.
//   - Everything else: denied.
//
// EMAIL VERIFICATION GATE (Oct 2026): every account must verify its email
// address (Firebase sends the link at sign-up; sign-in is blocked until it
// is clicked). isVerifiedUser() enforces this server-side: unverified
// sessions can authenticate NOTHING except creating their own students/
// {uid} profile doc at sign-up. This is defense in depth — the client
// already refuses to hold or mint sessions for unverified accounts.
// ⚠️ PUBLISH REQUIRED: these rules take effect only after pasting this
// file into Firebase Console → Firestore → Rules and clicking Publish.
//
// VERIFIED against the live write shape (Oct 2026): every worksheet POST
// (biweek-planner, toefl-ibt, rfc2, rfc3, syntax-clash, writequest, the
// React submitScore module and CMC.submitDrill) sends integer scorePct
// 0-100, integer correctCount/totalCount >= 0, and studentUid matching
// the Bearer token's own uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // SITE-OWNER ADMIN GRANT (Oct 2026): the owner's account is admin of
    // the whole site, keyed by Firebase UID (immutable across email
    // changes; the uid is already public via the classes collection as
    // teacherUid). Email verification is still required. OR'd into
    // isCmcTeacher() so EVERY teacher gate opens for this account, and
    // isVerifiedTeacher() waives the teachers/{uid} allowlist doc for it.
    // The same UID is hardcoded client-side (src/lib/firebaseAuth.ts
    // ADMIN_UIDS) — keep the two in sync.
    function isCmcAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == '5iLvnjzmV8QY7WFZhyTq6PIgcI63';
    }

    // A signed-in account whose email contains "edu" — or the site-owner
    // admin account — that finished email verification. This is the same
    // heuristic the CMC app (RoleGate / firebaseAuth.detectRoleFromEmail)
    // uses to decide who is a teacher, hardened with the verification gate
    // and extended with the admin grant. RE2 has no look-around, so keep
    // this in sync with the app if the heuristic ever changes.
    function isCmcTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && (request.auth.token.email.matches('.*[eE][dD][uU].*')
            || isCmcAdmin());
    }

    // A signed-in account that proved its email address by clicking the
    // verification link. Required for every student-reachable write.
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    match /drill_attempts/{attemptId} {
      allow read: if true; // public scoreboard (ticker / leaderboard / dashboard)

      allow create: if isVerifiedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid is string
        && request.resource.data.studentName is string
        && request.resource.data.drillSlug is string
        && request.resource.data.drillTitle is string
        && request.resource.data.drillSource is string
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0;

      // Score history is append-only — nobody rewrites results.
      allow update, delete: if false;
    }

    match /teacher_chat/{msgId} {
      allow read: if true; // public chat wall
      allow create: if isVerifiedUser()
        && request.resource.data.authorName is string
        && request.resource.data.text is string;
      allow update, delete: if false;
    }

    match /students/{uid} {
      // CREATE with just sign-in: the signup flow writes the profile doc
      // while the brand-new (still unverified) auth context exists. Every
      // other access — read included — requires a verified email.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isVerifiedUser() && request.auth.uid == uid;
    }

    match /classes/{classId} {
      allow read: if true; // class-code lookup + dashboards
      allow create, update: if isVerifiedUser();
      // Owner-only delete: `resource` is the class doc being removed, and
      // every class doc carries teacherUid (createClass stamps it), so this
      // costs no extra reads. Delete also implicitly drops the class code
      // from join lookups (getClassByCode queries this collection).
      allow delete: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid;

      match /enrollments/{studentUid} {
        allow read: if true;
        allow create, update: if isVerifiedUser() && request.auth.uid == studentUid;
        // Delete: the enrolled student themself (leave class), or the class
        // owner (teacherUid was stamped on the enrollment doc at join time).
        // Docs created before that stamping began have no teacherUid —
        // resource.data.teacherUid is then null and the comparison denies,
        // which is safe: they remain harmless orphans under a deleted class.
        allow delete: if isVerifiedUser()
          && (request.auth.uid == studentUid
              || resource.data.teacherUid == request.auth.uid);
      }
    }

    // Daily Student Assessment Records — teachers-only workspace.
    // Read: any teacher (staff-room visibility of rosters/averages).
    // Write: any teacher (collegial editing — every write is stamped with
    // updatedBy + server updatedAt in the client data layer, so edits are
    // attributable). Classes are archived, never deleted, from the client.
    match /assessment_classes/{classId} {
      allow read: if isCmcTeacher();
      allow create: if isCmcTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid is string;
      allow update: if isCmcTeacher();
      allow delete: if false;

      match /students/{studentId} {
        allow read: if isCmcTeacher();
        allow create, update: if isCmcTeacher();
        allow delete: if isCmcTeacher();
      }
    }

    // ── Private bi-weekly test system (Option A: teacher-side grading) ──
    //
    // Flow: teacher creates test_assignments/{id} for a class → students open
    // the private (answer-free) test page, sign in, and POST raw answers to
    // test_submissions/{assignmentId}__{studentUid} → the teacher dashboard
    // grades locally against test_keys/{testId} and caches scores in
    // test_scores/{submissionId}. Students can NEVER read the key, any score,
    // or anyone else's submission.
    //
    // teachers/{uid}: append-only allowlist that hardens the "email contains
    // edu" heuristic for the sensitive collections (answer keys!). Any edu
    // account may register itself ONCE (create), after which the doc is
    // immutable. Sensitive collections require BOTH the edu heuristic AND an
    // allowlist entry. To tighten further, replace isCmcTeacher() inside
    // isVerifiedTeacher() with a hardcoded email check.

    match /teachers/{uid} {
      allow read: if request.auth != null; // role checks only; non-sensitive
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isCmcTeacher();
      allow update, delete: if false; // allowlist is append-only
    }

    function isVerifiedTeacher() {
      return request.auth.uid is string
        && (isCmcAdmin()
            || (isCmcTeacher()
                && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))));
    }

    // Test shell metadata (title, groups, question count). NO answers here.
    match /biweekly_tests/{testId} {
      allow read: if true;
      allow create, update: if isVerifiedTeacher();
      allow delete: if false;
    }

    // THE answer key. The single most protected collection on the site.
    match /test_keys/{testId} {
      allow read, write: if isVerifiedTeacher();
    }

    // One assignment = test + class + window.
    match /test_assignments/{assignmentId} {
      allow read: if isVerifiedTeacher()
        || (isVerifiedUser()
            && resource.data.classId is string
            && exists(/databases/$(database)/documents/classes/$(resource.data.classId)/enrollments/$(request.auth.uid)));
      allow create, update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }

    // Raw student answers. Doc ID is "{assignmentId}__{studentUid}" so the
    // create-once rule IS the one-attempt rule: a second create with the same
    // ID fails at the database level, not just in the UI. Students may GET
    // their own doc (resume UX) but can never list or read anyone else's.
    match /test_submissions/{docId} {
      allow get: if isVerifiedTeacher()
        || (isVerifiedUser()
            && resource.data.studentUid == request.auth.uid);
      allow list: if isVerifiedTeacher();

      allow create: if isVerifiedUser()
        && request.auth.uid is string
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.testId is string
        && request.resource.data.classId is string
        && request.resource.data.studentName is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.answers is map
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 300
        && request.resource.data.integrity is map
        && docId == (request.resource.data.assignmentId + '__' + request.auth.uid)
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.opensAt <= request.time
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.closesAt >= request.time;

      // Append-only: nobody (not even the teacher) rewrites a submission.
      allow update, delete: if false;
    }

    // Computed scores + per-skill breakdown + most-missed data. Teachers only.
    match /test_scores/{docId} {
      allow read, write: if isVerifiedTeacher();
    }

    // Default-deny everything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
