# Copy to .env.local and fill in if you want to override the defaults.
# NOTE: every value below is a PUBLIC client-side Firebase web config value —
# it ships inside the JS bundle regardless. These are NOT server secrets.
# Real hardening is done in Google Cloud Console by restricting the web API
# key to your domains (HTTP referrer restrictions), not by hiding it here.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
