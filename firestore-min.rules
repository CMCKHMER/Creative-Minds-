rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCmcAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == '5iLvnjzmV8QY7WFZhyTq6PIgcI63';
    }
    function isCmcTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && ((request.auth.token.email.matches('.*@([^@]*[.])?([eE][dD][uU]|[aA][cC])([.][a-zA-Z]{2})?$')
             && isAllowedSchoolDomain())
            || isCmcAdmin());
    }
    function teacherAccessDoc() {
      return get(/databases/$(database)/documents/site_config/teacher_access).data;
    }
    function teacherAccessList(field) {
      return exists(/databases/$(database)/documents/site_config/teacher_access)
        && field in teacherAccessDoc()
        && request.auth.uid in teacherAccessDoc()[field];
    }
    function isAdminApprovedTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && teacherAccessList('approvedUids')
        && !teacherAccessList('revokedUids');
    }
    function isRevokedTeacher() {
      return request.auth != null && teacherAccessList('revokedUids');
    }
    function schoolDomainPattern() {
      return exists(/databases/$(database)/documents/site_config/teacher_access)
        && 'allowedEmailDomainsPattern' in teacherAccessDoc()
        && teacherAccessDoc().allowedEmailDomainsPattern is string
        && teacherAccessDoc().allowedEmailDomainsPattern.size() > 0
        ? teacherAccessDoc().allowedEmailDomainsPattern
        : 'aii\\.edu\\.kh';
    }
    function isAllowedSchoolDomain() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@]+@(' + schoolDomainPattern() + ')$');
    }
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    match /drill_attempts/{attemptId} {
      allow read: if true;
      function notInviteMode() {
        return !('inviteMode' in request.resource.data)
          || request.resource.data.inviteMode == false;
      }
      allow create: if notInviteMode()
        && isVerifiedUser()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid is string
        && request.resource.data.studentName is string
        && request.resource.data.drillSlug is string
        && request.resource.data.drillTitle is string
        && request.resource.data.drillSource is string
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0;
      allow create: if notInviteMode()
        && request.resource.data.studentUid == ''
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 40
        && request.resource.data.drillSlug is string
        && request.resource.data.drillSlug.size() <= 64
        && request.resource.data.drillTitle is string
        && request.resource.data.drillTitle.size() <= 160
        && request.resource.data.drillSource == 'rfc3'
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalCount <= 500
        && (!('classId' in request.resource.data)
          || request.resource.data.classId == null
          || (request.resource.data.classId is string
            && request.resource.data.classId.size() <= 40));
      allow update, delete: if false;
    }
    match /homework_exports/{docId} {
      allow read: if isVerifiedTeacher();
      allow write: if false;
    }
    match /invite_codes/{code} {
      allow read: if true;
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && code.size() >= 8
        && code.size() <= 32;
      allow update: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }
    match /invite_attempts/{attemptId} {
      allow read: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 3
        && request.resource.data.inviteCode.size() <= 32
        && exists(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invite_codes/$(request.resource.data.inviteCode)).data.teacherUid == request.resource.data.teacherUid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 1
        && request.resource.data.studentName.size() <= 60
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() <= 24
        && request.resource.data.drillSlug is string
        && request.resource.data.drillSlug.size() >= 1
        && request.resource.data.drillSlug.size() <= 80
        && request.resource.data.drillTitle is string
        && request.resource.data.drillTitle.size() >= 1
        && request.resource.data.drillTitle.size() <= 120
        && request.resource.data.scorePct is int
        && request.resource.data.scorePct >= 0
        && request.resource.data.scorePct <= 100
        && request.resource.data.correctCount is int
        && request.resource.data.correctCount >= 0
        && request.resource.data.correctCount <= 10000
        && request.resource.data.totalCount is int
        && request.resource.data.totalCount >= 0
        && request.resource.data.totalCount <= 10000
        && (!('classId' in request.resource.data) || request.resource.data.classId == null)
        && (!('sealed' in request.resource.data) || request.resource.data.sealed is bool)
        && (!('sheet' in request.resource.data)
            || (request.resource.data.sheet is string
                && request.resource.data.sheet.size() <= 20000));
      allow update, delete: if false;
    }
    match /teacher_chat/{msgId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    function isCmcApprovedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isCmcAdmin()
            || (exists(/databases/$(database)/documents/site_config/admins)
                && request.auth.uid in
                    get(/databases/$(database)/documents/site_config/admins).data.get('uids', [])));
    }
    function announcementExtrasOk(d) {
      return d.get('videoUrl', '') is string
        && d.get('videoUrl', '').size() <= 2000
        && d.get('videoUrl', '').matches('(https?://.+)?')
        && d.get('linkUrl', '') is string
        && d.get('linkUrl', '').size() <= 2000
        && d.get('linkUrl', '').matches('(https?://.+)?')
        && d.get('linkLabel', '') is string
        && d.get('linkLabel', '').size() <= 80;
    }
    match /announcements/{postId} {
      allow read: if true;
      allow create: if isCmcApprovedAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 900000
        && request.resource.data.pinned is bool
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid is string
        && request.resource.data.authorName is string
        && request.resource.data.authorEmail is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && announcementExtrasOk(request.resource.data);
      allow update: if isCmcApprovedAdmin() && announcementExtrasOk(request.resource.data);
      allow delete: if isCmcApprovedAdmin();
    }
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isCmcAdmin();
    }
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.accountType in ['student', 'teacher', 'user'];
      allow get, update: if isVerifiedUser() && request.auth.uid == uid;
      allow list: if isCmcAdmin();
      allow delete: if isCmcAdmin() || (isVerifiedUser() && request.auth.uid == uid);
    }
    match /user_avatars/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isCmcAdmin());
      allow list: if isCmcAdmin();
      allow create, update: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'photo', 'preset', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.kind in ['photo', 'preset']
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 90000
        && request.resource.data.preset is string
        && request.resource.data.preset.size() <= 40
        && ((request.resource.data.kind == 'preset'
              && request.resource.data.photo == ''
              && request.resource.data.preset.matches('^[a-z0-9-]{1,40}$'))
            || (request.resource.data.kind == 'photo'
              && request.resource.data.preset == ''
              && request.resource.data.photo.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/]+=*$')));
      allow delete: if isVerifiedUser() && (request.auth.uid == uid || isCmcAdmin());
    }
    match /students/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isVerifiedUser() && request.auth.uid == uid;
    }
    match /classes/{classId} {
      allow read: if true;
      allow create: if isVerifiedTeacher();
      allow update: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid;
      allow delete: if isVerifiedUser()
        && resource.data.teacherUid == request.auth.uid;
      match /enrollments/{studentUid} {
        allow read: if true;
        allow create, update: if isVerifiedUser() && request.auth.uid == studentUid;
        allow delete: if isVerifiedUser()
          && (request.auth.uid == studentUid
              || resource.data.teacherUid == request.auth.uid);
      }
    }
    function ownsAssessmentClassDoc(c) {
      return c.teacherUid == request.auth.uid
        || ('teacherEmail' in c
            && c.teacherEmail is string
            && c.teacherEmail.size() > 0
            && c.teacherEmail == request.auth.token.email)
        || isCmcAdmin();
    }
    function ownsAssessmentClass(classId) {
      return ownsAssessmentClassDoc(
        get(/databases/$(database)/documents/assessment_classes/$(classId)).data);
    }
    match /assessment_classes/{classId} {
      allow read: if isCmcTeacher() && ownsAssessmentClassDoc(resource.data);
      allow create: if isCmcTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid is string;
      allow update: if isCmcTeacher()
        && ownsAssessmentClassDoc(resource.data)
        && (request.resource.data.teacherUid == resource.data.teacherUid
            || request.resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
      match /students/{studentId} {
        allow read, write: if isCmcTeacher() && ownsAssessmentClass(classId);
      }
    }
    function ownsSeatDoc(d) {
      return d.teacherUid == request.auth.uid || isCmcAdmin();
    }
    match /roster_seats/{seatKey} {
      allow get: if isVerifiedUser();
      allow list: if isCmcTeacher() && ownsSeatDoc(resource.data);
      allow create: if isCmcTeacher() && ownsSeatDoc(request.resource.data);
      allow delete: if isCmcTeacher() && ownsSeatDoc(resource.data);
      allow update: if (isCmcTeacher()
            && ownsSeatDoc(resource.data)
            && ownsSeatDoc(request.resource.data))
        || (isVerifiedUser()
            && resource.data.claimedBy == null
            && request.resource.data.claimedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['claimedBy', 'claimedEmail', 'claimedName', 'claimedAt'])
            && getAfter(/databases/$(database)/documents/student_links/$(request.auth.uid)).data.seatKey == seatKey);
    }
    match /student_links/{uid} {
      allow get: if isVerifiedUser() && (request.auth.uid == uid || isCmcTeacher());
      allow list: if isCmcAdmin();
      allow create: if isVerifiedUser()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.seatKey is string
        && request.resource.data.keys().hasOnly(['uid', 'seatKey', 'linkedAt'])
        && getAfter(/databases/$(database)/documents/roster_seats/$(request.resource.data.seatKey)).data.claimedBy == uid;
      allow update, delete: if isCmcTeacher()
        && (!exists(/databases/$(database)/documents/roster_seats/$(resource.data.seatKey))
            || ownsSeatDoc(get(/databases/$(database)/documents/roster_seats/$(resource.data.seatKey)).data));
    }
    match /teachers/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if isCmcAdmin();
      allow update: if false;
    }
    function isVerifiedTeacher() {
      return request.auth != null
        && (isCmcAdmin()
            || (isAdminApprovedTeacher())
            || (isCmcTeacher()
                && !isRevokedTeacher()
                && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))));
    }
    match /biweekly_tests/{testId} {
      allow read: if true;
      allow create, update: if isVerifiedTeacher();
      allow delete: if false;
    }
    match /test_keys/{testId} {
      allow read: if isVerifiedTeacher()
        && (resource.data.teacherUid == request.auth.uid
            || !('teacherUid' in resource.data));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (!('teacherUid' in resource.data)
            || resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
    }
    match /teacher_secrets/{secretId} {
      allow get: if isVerifiedTeacher();
      allow list: if false;
      allow create, update: if isCmcAdmin()
        && request.resource.data.key is string
        && request.resource.data.key.size() >= 20
        && request.resource.data.key.size() <= 200;
      allow delete: if false;
    }
    match /test_assignments/{assignmentId} {
      allow read: if request.auth != null
        && (resource.data.teacherUid == request.auth.uid
            || (isVerifiedUser()
                && resource.data.classId is string
                && exists(/databases/$(database)/documents/classes/$(resource.data.classId)/enrollments/$(request.auth.uid))));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
    }
    match /test_submissions/{docId} {
      allow get: if (isVerifiedUser()
            && resource.data.studentUid == request.auth.uid)
        || (isVerifiedTeacher()
            && (resource.data.teacherUid == request.auth.uid
                || !('teacherUid' in resource.data)));
      allow list: if isVerifiedTeacher()
        && resource.data.teacherUid == request.auth.uid;
      allow create: if isVerifiedUser()
        && request.auth.uid is string
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.testId is string
        && request.resource.data.classId is string
        && request.resource.data.studentName is string
        && request.resource.data.status == 'submitted'
        && request.resource.data.answers is map
        && request.resource.data.answers.size() > 0
        && request.resource.data.answers.size() <= 300
        && request.resource.data.integrity is map
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid.size() > 0
        && docId == (request.resource.data.assignmentId + '__' + request.auth.uid)
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.teacherUid == request.resource.data.teacherUid
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.opensAt <= request.time
        && get(/databases/$(database)/documents/test_assignments/$(request.resource.data.assignmentId)).data.closesAt >= request.time;
      allow update, delete: if false;
    }
    function isOwnPracticePath(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isValidPracticeAttempt(uid) {
      let d = request.resource.data;
      return d.uid is string
        && d.uid == uid
        && d.skill in ['writing', 'speaking']
        && d.band is number
        && d.band >= 0
        && d.band <= 5
        && d.createdAt is timestamp
        && (!('text' in d) || (d.text is string && d.text.size() <= 4000))
        && (!('traits' in d) || d.traits is map)
        && (!('stats' in d) || d.stats is map);
    }
    match /practice_attempts/{uid}/attempts/{attemptId} {
      allow read: if isOwnPracticePath(uid) || isVerifiedTeacher();
      allow create: if isVerifiedUser() && isOwnPracticePath(uid) && isValidPracticeAttempt(uid);
      allow update, delete: if false;
    }
    match /practice_reviews/{attemptId} {
      allow read: if isVerifiedTeacher()
        || (request.auth != null && request.auth.uid == resource.data.studentUid);
      allow create, update: if isVerifiedTeacher()
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.attemptId == attemptId
        && request.resource.data.studentUid is string
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 600
        && (request.resource.data.band == null
            || (request.resource.data.band is number
                && request.resource.data.band >= 0
                && request.resource.data.band <= 5));
      allow delete: if false;
    }
    match /test_scores/{docId} {
      allow read: if isVerifiedTeacher()
        && (resource.data.teacherUid == request.auth.uid
            || !('teacherUid' in resource.data));
      allow create: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid;
      allow update: if isVerifiedTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && (!('teacherUid' in resource.data)
            || resource.data.teacherUid == request.auth.uid);
      allow delete: if false;
    }
    match /ticker_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /chess_rooms/{roomId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.hostColor in ['w', 'b']
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.result == null
        && request.resource.data.drawOffer == null
        && request.resource.data.gameNo == 1;
      allow update: if isVerifiedUser()
        && ((resource.data.guestUid == null
             && request.resource.data.guestUid == request.auth.uid)
            || request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid);
      allow delete: if isVerifiedUser() && resource.data.hostUid == request.auth.uid;
    }
    match /mafia_rooms/{roomId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.status == 'open'
        && request.resource.data.engine is string;
      allow update: if isVerifiedUser()
        && request.auth.uid == resource.data.hostUid;
      allow delete: if isVerifiedUser()
        && request.auth.uid == resource.data.hostUid;
      match /views/{uid} {
        allow read: if isVerifiedUser() && request.auth.uid == uid;
        allow create, update: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
        allow delete: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
      }
      match /actions/{uid} {
        allow read: if isVerifiedUser()
          && (request.auth.uid == uid
              || request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid);
        allow create, update: if isVerifiedUser() && request.auth.uid == uid;
        allow delete: if isVerifiedUser()
          && request.auth.uid == get(/databases/$(database)/documents/mafia_rooms/$(roomId)).data.hostUid;
      }
    }
    match /word_creator_rooms/{roomId} {
      function wcSeated(seats, uid) {
        return (seats.size() > 0 && seats[0].uid == uid)
          || (seats.size() > 1 && seats[1].uid == uid)
          || (seats.size() > 2 && seats[2].uid == uid)
          || (seats.size() > 3 && seats[3].uid == uid);
      }
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser()
        && request.resource.data.code == roomId
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.seed is string
        && request.resource.data.seed.size() >= 8
        && request.resource.data.seatsWanted is int
        && request.resource.data.seatsWanted >= 2
        && request.resource.data.seatsWanted <= 4
        && request.resource.data.status == 'waiting'
        && request.resource.data.seats is list
        && request.resource.data.seats.size() == 1
        && request.resource.data.seats[0].uid == request.auth.uid
        && request.resource.data.seats[0].host == true
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.turn == 0
        && request.resource.data.result == null;
      allow update: if isVerifiedUser()
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.seed == resource.data.seed
        && request.resource.data.seatsWanted == resource.data.seatsWanted
        && request.resource.data.seats is list
        && request.resource.data.moves is list
        && (
          (
            resource.data.status == 'waiting'
            && !wcSeated(resource.data.seats, request.auth.uid)
            && resource.data.seats.size() < resource.data.seatsWanted
            && request.resource.data.seats.size() == resource.data.seats.size() + 1
            && request.resource.data.seats[0:resource.data.seats.size()] == resource.data.seats
            && request.resource.data.seats[resource.data.seats.size()].uid == request.auth.uid
            && request.resource.data.seats[resource.data.seats.size()].host == false
            && request.resource.data.moves.size() == 0
            && request.resource.data.turn == 0
            && request.resource.data.result == null
            && (
              (request.resource.data.seats.size() == resource.data.seatsWanted
                && request.resource.data.status == 'playing')
              || (request.resource.data.seats.size() < resource.data.seatsWanted
                && request.resource.data.status == 'waiting')
            )
          )
          || (
            resource.data.status == 'playing'
            && request.resource.data.seats == resource.data.seats
            && request.resource.data.moves.size() == resource.data.moves.size() + 1
            && request.resource.data.moves[0:resource.data.moves.size()] == resource.data.moves
            && resource.data.seats[resource.data.moves.size() % resource.data.seats.size()].uid == request.auth.uid
            && request.resource.data.moves[resource.data.moves.size()].uid == request.auth.uid
            && request.resource.data.turn == request.resource.data.moves.size() % resource.data.seats.size()
            && (
              (request.resource.data.status == 'playing' && request.resource.data.result == null)
              || (request.resource.data.status == 'finished' && request.resource.data.result != null)
            )
          )
        );
      allow delete: if isVerifiedUser()
        && wcSeated(resource.data.seats, request.auth.uid);
    }
    function linkedTestQuestionOk(q) {
      return q is map
        && q.keys().hasOnly(['g', 'i', 'p', 'c', 'm'])
        && q.g is string && q.g.size() >= 1 && q.g.size() <= 100
        && q.i is number && q.i >= 0 && q.i <= 500
        && q.p is string && q.p.size() >= 1 && q.p.size() <= 2000
        && q.c is list && q.c.size() >= 2 && q.c.size() <= 12
        && q.c.all(ch, ch is string && ch.size() >= 0 && ch.size() <= 2000)
        && (q.m is bool || q.m == null);
    }
    function linkedTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'kicker', 'instructions', 'transcript', 'minutes', 'groups', 'questions', 'audios', 'total'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() >= 1 && t.title.size() <= 200
        && t.kicker is string && t.kicker.size() <= 200
        && t.instructions is string && t.instructions.size() <= 4000
        && t.transcript is string && t.transcript.size() <= 8000
        && t.minutes is number && t.minutes >= 0 && t.minutes <= 300
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.groups is list && t.groups.size() >= 1 && t.groups.size() <= 50
        && t.groups.all(g, g is map && g.keys().hasOnly(['id', 'title', 'dirs'])
          && g.id is string && g.id.size() >= 1 && g.id.size() <= 100
          && g.title is string && g.title.size() <= 300
          && g.dirs is string && g.dirs.size() <= 600)
        && t.questions is list && t.questions.size() >= 1 && t.questions.size() <= 500
        && t.questions.all(linkedTestQuestionOk)
        && t.audios is list && t.audios.size() <= 20
        && t.audios.all(a, a is map && a.keys().hasOnly(['label', 'src'])
          && a.label is string && a.label.size() <= 300
          && a.src is string && a.src.size() <= 300);
    }
    function studioDocFieldsOk(d) {
      return d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 200
        && d.kind in ['doc', 'sheet']
        && d.mode in ['view', 'collect']
        && d.ownerUid == request.auth.uid
        && d.ownerName is string
        && d.ownerName.size() >= 1
        && d.ownerName.size() <= 60
        && d.createdAt is string
        && d.createdAt.size() <= 40
        && d.updatedAt is string
        && d.updatedAt.size() <= 40
        && d.revision is number
        && d.revision >= 1
        && d.revision <= 10000
        && d.data is map
        && (!(d.keys().hasAny(['linkedTest'])) || linkedTestOk(d.linkedTest))
        && ((d.kind == 'doc'
             && d.data.doc is string
             && d.data.doc.size() <= 600000
             && d.data.docHeader is string
             && d.data.docHeader.size() <= 60000
             && d.data.docFooter is string
             && d.data.docFooter.size() <= 60000)
           || (d.kind == 'sheet'
             && d.data.sheets is list
             && d.data.sheets.size() >= 1
             && d.data.sheets.size() <= 12));
    }
    match /studio_docs/{docId} {
      allow read: if true;
      allow create: if isCmcTeacher() && studioDocFieldsOk(request.resource.data);
      allow update: if isCmcTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.kind == resource.data.kind
        && studioDocFieldsOk(request.resource.data);
      allow delete: if isCmcTeacher() && resource.data.ownerUid == request.auth.uid;
      allow list: if isCmcTeacher();
    }
    function studioSubTestOk(t) {
      return t is map
        && t.keys().hasOnly(['slug', 'title', 'total', 'answered', 'answers'])
        && t.slug is string && t.slug.size() >= 1 && t.slug.size() <= 100
        && t.title is string && t.title.size() <= 200
        && t.total is number && t.total >= 1 && t.total <= 500
        && t.answered is number && t.answered >= 0 && t.answered <= 500
        && t.answers is list && t.answers.size() >= 1 && t.answers.size() <= 500
        && t.answers.all(x, x == null || (x is number && x >= 0 && x <= 20));
    }
    function studioSubFieldsOk(d) {
      return d.docId is string
        && d.docId.size() >= 10
        && d.docId.size() <= 100
        && d.docTitle is string
        && d.docTitle.size() <= 200
        && d.ownerUid is string
        && d.ownerUid.size() <= 100
        && d.kind in ['doc', 'sheet']
        && d.studentName is string
        && d.studentName.size() >= 1
        && d.studentName.size() <= 40
        && d.answers is map
        && d.answers.size() <= 400
        && (d.answers.size() >= 1
            || (d.keys().hasAny(['test'])
                && d.test is map
                && d.test.answered is number
                && d.test.answered >= 1))
        && (!(d.keys().hasAny(['test'])) || studioSubTestOk(d.test))
        && d.submittedAt is string
        && d.submittedAt.size() <= 40
        && get(/databases/$(database)/documents/studio_docs/$(d.docId)).data.mode == 'collect';
    }
    match /studio_submissions/{subId} {
      allow get: if isCmcTeacher()
        || (isVerifiedUser() && resource.data.studentUid == request.auth.uid);
      allow list: if isCmcTeacher();
      allow create: if isVerifiedUser()
        && request.resource.data.studentUid == request.auth.uid
        && subId == (request.resource.data.docId + '__' + request.auth.uid)
        && studioSubFieldsOk(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
